local function showPlayerTab()
    clearContent()
    updateTabs(playerTab)
    
    local espLabel, espToggle, espKnob = createToggle("ESP", 10, "ESP", contentFrame)
    local jumpLabel, jumpToggle, jumpKnob = createToggle("JUMP HIGH", 55, "JUMP_HIGH", contentFrame)
    local flyLabel, flyToggle, flyKnob = createToggle("FLY", 100, "FLY", contentFrame)
    local speedLabel, speedToggle, speedKnob = createToggle("SPEED", 145, "SPEED", contentFrame)
    
    local jumpSlider = nil
    local speedSlider = nil
    
    local function refreshSliders()
        if jumpSlider then jumpSlider:Destroy() end
        if speedSlider then speedSlider:Destroy() end
        
        local currentY = 190
        
        if toggleStates.JUMP_HIGH then
            jumpSlider = createSlider("JUMP POWER", currentY, 50, 200, settings.JUMP_POWER, contentFrame, "JUMP_POWER")
            currentY = currentY + 75
        end
        
        if toggleStates.SPEED then
            speedSlider = createSlider("WALK SPEED", currentY, 16, 100, settings.WALK_SPEED, contentFrame, "WALK_SPEED")
        end
    end
    
    setupToggle(espToggle, espKnob, "ESP", function()
        for _, otherPlayer in pairs(Players:GetPlayers()) do
            if otherPlayer ~= player then addHighlight(otherPlayer) end
        end
    end, function()
        clearAllHighlights()
    end)
    
    setupToggle(jumpToggle, jumpKnob, "JUMP_HIGH", function()
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.JumpPower = settings.JUMP_POWER end
        end
        refreshSliders()
    end, function()
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.JumpPower = 50 end
        end
        refreshSliders()
    end)
    
    setupToggle(flyToggle, flyKnob, "FLY")
    
    setupToggle(speedToggle, speedKnob, "SPEED", function()
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.WalkSpeed = settings.WALK_SPEED end
        end
        refreshSliders()
    end, function()
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChild("Humanoid")
            if humanoid then humanoid.WalkSpeed = 16 end
        end
        refreshSliders()
    end)
    
    refreshSliders()
end

